# Local development; do not expose the local server to the Internet.
ENVIRONMENT=local
PUBLIC_ORIGIN=http://127.0.0.1:8000
SEED_DEMO=true
# Fresh demo databases start with admin / 000000. Set false for manual setup.
DEMO_ADMIN=true
AGENT_MODE=demo
DATABASE_URL=sqlite:///./data/admin.db
QDRANT_URL=
QDRANT_PATH=./data/qdrant
# Empty locally: generated once under data/secrets, retained across restarts.
ENCRYPTION_KEY=
SETUP_TOKEN=
# Chat providers are configured in the admin UI. Embeddings are separate.
EMBEDDING_MODE=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# KNOWLEDGE_DIR=./knowledge
